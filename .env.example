# Copy to `.env` for local Replit / pnpm dev. Do not commit real values.
# Set the same keys in the Vercel project for Preview + Production (dashboard or `vercel env add`).

# --- Shared / API (artifacts/api-server, lib/db) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FOOTBALL_DATA_API_KEY=
# Optional: used for invite/origin fallbacks
APP_URL=
PORT=3001
LOG_LEVEL=info

# --- Frontend (artifacts/sorare-companion; Vite bake-time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
